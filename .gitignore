# NO TRAILING SLASH, deliberately. `node_modules/` matches a DIRECTORY only, and on 2026-08-05 a
# `node_modules` SYMLINK pointing at its own absolute path got committed (32ed0e1) because it
# slipped straight past that rule. The result was a self-referential loop: every root binary
# resolved to `Too many levels of symbolic links`, so `tsc`, `eslint` and `vitest` were all dead on
# a fresh checkout, with an error naming none of them. Without the slash this matches the name
# whatever it is — directory, symlink or file.
node_modules
dist/
dist-ssr/
.vite/
*.local

# Firebase config is injected at build time — never commit real credentials
.env
.env.*
!.env.example
.firebase/
firebase-debug.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Claude Code session state, including git worktrees (a full second checkout of this repo).
# Committing those would nest the repo inside itself; linting them breaks the build.
.claude/
